//@version=5
indicator("Dynamic Anchor Intra-Bar StDev Bands", overlay=true)


// ============================================================================
// TIMEFRAME PRESET PROFILES
// ============================================================================
type HTFBar
    float o = open
    float h = high
    float l = low
    float c = close
    int   t = time

string grp_mtf = "Multi-Timeframe Engine"

// 1. Define the 10 Preset String Constants (plus a Custom option)
string OPT_C  = "⚙️ Custom (Use Manual Inputs)"
string OPT_1  = "⚡ Micro Scalping (1m, 2m, 5m)"
string OPT_2  = "⏱️ Standard Scalping (1m, 5m, 15m)"
string OPT_3  = "🏃 Fast Intraday (3m, 15m, 60m)"
string OPT_4  = "🚶 Standard Intraday (5m, 15m, 60m)"
string OPT_5  = "📅 Session Trading (15m, 60m, 240m)"
string OPT_6  = "🏄 Intraday Swing (30m, 120m, D)"
string OPT_7  = "🌊 Standard Swing (60m, 240m, D)"
string OPT_8  = "🧭 Position Trading (240m, D, W)"
string OPT_9  = "🌍 Macro Trend (D, W, M)"
string OPT_10 = "🌌 Deep Macro Investing (W, M, 12M)"

// 2. Create the Dropdown Input
presetProfile = input.string(OPT_1, title="Trading Horizon Profile", options=[OPT_C, OPT_1, OPT_2, OPT_3, OPT_4, OPT_5, OPT_6, OPT_7, OPT_8, OPT_9, OPT_10], group=grp_mtf)

// 3. Keep manual inputs for the "Custom" override
manual_tf_s = input.timeframe("1",  title="Manual Short TF",  inline="tf_s", group=grp_mtf)
manual_tf_m = input.timeframe("5",  title="Manual Medium TF", inline="tf_m", group=grp_mtf)
manual_tf_l = input.timeframe("15", title="Manual Long TF",   inline="tf_l", group=grp_mtf)

// ============================================================================
// PRESET SWITCH LOGIC
// ============================================================================
// 4. Dynamically assign the active timeframes based on the selected dropdown
[active_tf_s, active_tf_m, active_tf_l] = switch presetProfile
    OPT_1  => ["1",   "2",   "5"]
    OPT_2  => ["1",   "5",   "15"]
    OPT_3  => ["3",   "15",  "60"]
    OPT_4  => ["5",   "15",  "60"]
    OPT_5  => ["15",  "60",  "240"]
    OPT_6  => ["30",  "120", "D"]
    OPT_7  => ["60",  "240", "D"]
    OPT_8  => ["240", "D",   "W"]
    OPT_9  => ["D",   "W",   "M"]
    OPT_10 => ["W",   "M",   "12M"]
    => [manual_tf_s, manual_tf_m, manual_tf_l] // Defaults to OPT_C (Custom)



// Lookback Settings
lengthInput = input.int(20, title="StDev Lookback Period")
multInput = input.float(1.0, title="StDev Multiplier")

// Visibility Toggles
showOC = input.bool(true, title="Show OC (Open/Close Bands)", group="Visibility Toggles")
showOH = input.bool(true, title="Show OH (Open/High Bands)", group="Visibility Toggles")
showOL = input.bool(true, title="Show OL (Open/Low Bands)", group="Visibility Toggles")
showLH = input.bool(true, title="Show LH (Low/High Bands)", group="Visibility Toggles")
showHC = input.bool(true, title="Show HC (High/Close Bands)", group="Visibility Toggles")
showLC = input.bool(true, title="Show LC (Low/Close Bands)", group="Visibility Toggles")
showCO = input.bool(true, title="Show CO (Close/Open Bands)", group="Visibility Toggles")
showHL = input.bool(true, title="Show HL (High/Low Bands)", group="Visibility Toggles")

// Draw lifecycle caps
const int MAX_GC_BOXES = 220
const int MAX_GC_LINES = 320
const int MAX_GC_LABELS = 260
const int MAX_GC_POLYLINES = 80
const int GC_BATCH = 50

var box[] gc_boxes = array.new_box()
var line[] gc_lines = array.new_line()
var label[] gc_labels = array.new_label()
var polyline[] gc_polylines = array.new<polyline>()

track_box(box obj) =>
    if not na(obj)
        array.push(gc_boxes, obj)

track_line(line obj) =>
    if not na(obj)
        array.push(gc_lines, obj)

track_label(label obj) =>
    if not na(obj)
        array.push(gc_labels, obj)

track_polyline(polyline obj) =>
    if not na(obj)
        array.push(gc_polylines, obj)

trim_boxes(box[] arr, int cap, int maxOps) =>
    int ops = 0
    while array.size(arr) > cap and ops < maxOps
        box oldObj = array.shift(arr)
        if not na(oldObj)
            box.delete(oldObj)
        ops += 1

trim_lines(line[] arr, int cap, int maxOps) =>
    int ops = 0
    while array.size(arr) > cap and ops < maxOps
        line oldObj = array.shift(arr)
        if not na(oldObj)
            line.delete(oldObj)
        ops += 1

trim_labels(label[] arr, int cap, int maxOps) =>
    int ops = 0
    while array.size(arr) > cap and ops < maxOps
        label oldObj = array.shift(arr)
        if not na(oldObj)
            label.delete(oldObj)
        ops += 1

trim_polylines(polyline[] arr, int cap, int maxOps) =>
    int ops = 0
    while array.size(arr) > cap and ops < maxOps
        polyline oldObj = array.shift(arr)
        if not na(oldObj)
            polyline.delete(oldObj)
        ops += 1

run_gc() =>
    trim_boxes(gc_boxes, MAX_GC_BOXES, GC_BATCH)
    trim_lines(gc_lines, MAX_GC_LINES, GC_BATCH)
    trim_labels(gc_labels, MAX_GC_LABELS, GC_BATCH)
    trim_polylines(gc_polylines, MAX_GC_POLYLINES, GC_BATCH)

drawBox(HTFBar b, int right) =>
    color boxColor = b.c >= b.o ? color.green : color.red
    box.new(b.t, b.h, right, b.l, boxColor, xloc = xloc.bar_time, bgcolor = color.new(boxColor, 90))

updateBox(box boxId, HTFBar b, bool j = true, int len = 4) =>
    color boxColor = b.c >= b.o ? color.green : color.red
    box.set_border_color(boxId, boxColor)
    box.set_bgcolor(boxId, color.new(boxColor, 90))
    box.set_top(boxId, math.max(b.o, b.c))
    box.set_bottom(boxId, math.min(b.o, b.c))
    box.set_right(boxId, time)

getHTF(string tf) =>
    request.security(syminfo.tickerid, tf, HTFBar.new(open, high, low, close, time), gaps=barmerge.gaps_on)

secBarBox = getHTF(active_tf_l)


// ============================================================================
// SECURITY CALLS (Using the dynamically assigned variables)
// ============================================================================
// Note: Profile-resolved active timeframes are shared across both stdev and HTF engines.
secBars = getHTF(active_tf_s)
secBarm = getHTF(active_tf_m)
secBarl = getHTF(active_tf_l)



bool showT = input.bool(false, "Show Boxes")
if not na(secBarBox) and showT
    // To avoid a runtime error, only process data when an object exists.
    if not barstate.islast
        if timeframe.change(active_tf_l) and not na(time[1])
            // On historical bars, draw a new box in the past when the HTF closes.
            track_box(drawBox(secBarBox, time[1]))
    else
        var box lastBox = na
        if na(lastBox)
            lastBox := drawBox(secBarBox, time)
        else if timeframe.change(active_tf_l)
            track_box(lastBox)
            // On the last bar, only draw a new current box the first time we get there or when HTF changes.
            lastBox := drawBox(secBarBox, time)
        else
            // On other chart updates, use setters to modify the current box.
            updateBox(lastBox, secBarBox)

// Custom function to omit overnight differentials
f_gapless_stdev(src, length) =>
    // Check if the day changed on an intraday chart
    bool is_new_day = timeframe.isintraday and timeframe.change("D")
    
    // Ignore differential on new day; otherwise use normal change
    float priceChange = is_new_day or bar_index == 0 ? 0.0 : (src - src[1])
    
    // Reconstruct a seamless, gapless price series
    var float gaplessPrice = na
    gaplessPrice := bar_index == 0 ? src : gaplessPrice[1] + priceChange
    
    // Return standard deviation of the gapless series
    ta.stdev(gaplessPrice, length)


spread_for_pair(HTFBar b, string pair) =>
    pair == "OC" ? math.abs(b.c - b.o) :
     pair == "OH" ? math.abs(b.h - b.o) :
     pair == "OL" ? math.abs(b.o - b.l) :
     pair == "LH" ? math.abs(b.h - b.l) :
     pair == "HC" ? math.abs(b.h - b.c) :
     pair == "LC" ? math.abs(b.c - b.l) :
     pair == "CO" ? math.abs(b.o - b.c) :
     pair == "HL" ? math.abs(b.h - b.l) :
     na

tf_pair_stdev(HTFBar b, string pair, int length, float multiplier) =>
    not na(b) ? f_gapless_stdev(spread_for_pair(b, pair), length) * multiplier : na

pair_stdev_triplet(string pair, int length, float multiplier) =>
    [tf_pair_stdev(secBars, pair, length, multiplier), tf_pair_stdev(secBarm, pair, length, multiplier), tf_pair_stdev(secBarl, pair, length, multiplier)]

// Safe Variable Extraction to prevent "Cannot access field of na object" errors
float sec_os = not na(secBars) ? secBars.o : na
float sec_om = not na(secBarm) ? secBarm.o : na
float sec_ol = not na(secBarl) ? secBarl.o : na
float sec_hs = not na(secBars) ? secBars.h : na
float sec_hm = not na(secBarm) ? secBarm.h : na
float sec_hl = not na(secBarl) ? secBarl.h : na
float sec_ls = not na(secBars) ? secBars.l : na
float sec_lm = not na(secBarm) ? secBarm.l : na
float sec_ll = not na(secBarl) ? secBarl.l : na
float sec_cs = not na(secBars) ? secBars.c : na
float sec_cm = not na(secBarm) ? secBarm.c : na
float sec_cl = not na(secBarl) ? secBarl.c : na

// 2. Calculate Standard Deviations
[oc_stdevs, oc_stdevm, oc_stdevl] = pair_stdev_triplet("OC", lengthInput, multInput)
[oh_stdevs, oh_stdevm, oh_stdevl] = pair_stdev_triplet("OH", lengthInput, multInput)
[ol_stdevs, ol_stdevm, ol_stdevl] = pair_stdev_triplet("OL", lengthInput, multInput)
[lh_stdevs, lh_stdevm, lh_stdevl] = pair_stdev_triplet("LH", lengthInput, multInput)
[hc_stdevs, hc_stdevm, hc_stdevl] = pair_stdev_triplet("HC", lengthInput, multInput)
[lc_stdevs, lc_stdevm, lc_stdevl] = pair_stdev_triplet("LC", lengthInput, multInput)
[co_stdevs, co_stdevm, co_stdevl] = pair_stdev_triplet("CO", lengthInput, multInput)
[hl_stdevs, hl_stdevm, hl_stdevl] = pair_stdev_triplet("HL", lengthInput, multInput)

// 3. Plot Upper/Lower Bands Anchored to Relevant Structural Prices

showlast = input.int(5, "Show The Last", options = [5, 25, 200])
// Open-Close: Anchored to Open (Upper) and Close (Lower)
plot(showOC ? sec_os + oc_stdevs : na, title="s OC Upper (Open Anchor)", color=color.green, show_last = showlast, style = plot.style_stepline)
plot(showOC ? sec_om + oc_stdevm : na, title="m OC Upper (Open Anchor)", color=color.green, show_last = showlast, style = plot.style_stepline)
plot(showOC ? sec_ol + oc_stdevl : na, title="l OC Upper (Open Anchor)", color=color.green, show_last = showlast, style = plot.style_stepline)
plot(showOC ? sec_os - oc_stdevs : na, title="s OC Lower (Close Anchor)", color=color.red, show_last = showlast, style = plot.style_stepline)
plot(showOC ? sec_om - oc_stdevm : na, title="m OC Lower (Close Anchor)", color=color.red, show_last = showlast, style = plot.style_stepline)
plot(showOC ? sec_ol - oc_stdevl : na, title="l OC Lower (Close Anchor)", color=color.red, show_last = showlast, style = plot.style_stepline)

// Open-High: Anchored to High (Upper) and Open (Lower)
plot(showOH ? sec_os + oh_stdevs : na, title="s OH Upper (High Anchor)", color=color.green, show_last = showlast, style = plot.style_stepline)
plot(showOH ? sec_om + oh_stdevm : na, title="m OH Upper (High Anchor)", color=color.green, show_last = showlast, style = plot.style_stepline)
plot(showOH ? sec_ol + oh_stdevl : na, title="l OH Upper (High Anchor)", color=color.green, show_last = showlast, style = plot.style_stepline)
// plot(showOH ? sec_o - oh_stdev : na, title="OH Lower (Open Anchor)", color=color.green, style = plot.style_stepline)
// Open-Low: Anchored to Open (Upper) and Low (Lower)
// plot(showOL ? sec_o + ol_stdev : na, title="OL Upper (Open Anchor)", color=color.blue, style = plot.style_stepline)
plot(showOL ? sec_os - ol_stdevs : na, title="s OL Lower (Low Anchor)", color=color.red, show_last = showlast, style = plot.style_stepline)
plot(showOL ? sec_om - ol_stdevm : na, title="m OL Lower (Low Anchor)", color=color.red, show_last = showlast, style = plot.style_stepline)
plot(showOL ? sec_ol - ol_stdevl : na, title="l OL Lower (Low Anchor)", color=color.red, show_last = showlast, style = plot.style_stepline)

// High-Low: Anchored to High (Upper) and Low (Lower)
// plot(showHL ? sec_h + hl_stdev : na, title="HL Upper (High Anchor)", color=color.white, style = plot.style_stepline)
plot(showHL ? sec_hs - hl_stdevs : na, title="s HL Lower (Low Anchor)", color=color.red, show_last = showlast, style = plot.style_stepline)
plot(showHL ? sec_hm - hl_stdevm : na, title="m HL Lower (Low Anchor)", color=color.red, show_last = showlast, style = plot.style_stepline)
plot(showHL ? sec_hl - hl_stdevl : na, title="l HL Lower (Low Anchor)", color=color.red, show_last = showlast, style = plot.style_stepline)
// Low-High: Anchored to High (Upper) and Low (Lower)
plot(showLH ? sec_ls + lh_stdevs : na, title="s LH Upper (High Anchor)", color=color.green, show_last = showlast, style = plot.style_stepline)
plot(showLH ? sec_lm + lh_stdevm : na, title="m LH Upper (High Anchor)", color=color.green, show_last = showlast, style = plot.style_stepline)
plot(showLH ? sec_ll + lh_stdevl : na, title="l LH Upper (High Anchor)", color=color.green, show_last = showlast, style = plot.style_stepline)
// plot(showLH ? sec_h - lh_stdev : na, title="LH Lower (Low Anchor)", color=color.green, style = plot.style_stepline)

// High-Close: Anchored to High (Upper) and Close (Lower)
// plot(showHC ? sec_h + hc_stdev : na, title="HC Upper (High Anchor)", color=color.yellow, style = plot.style_stepline)
plot(showHC ? sec_hs - hc_stdevs : na, title="s HC Lower (Close Anchor)", color=color.red, show_last = showlast, style = plot.style_stepline)
plot(showHC ? sec_hm - hc_stdevm : na, title="m HC Lower (Close Anchor)", color=color.red, show_last = showlast, style = plot.style_stepline)
plot(showHC ? sec_hl - hc_stdevl : na, title="l HC Lower (Close Anchor)", color=color.red, show_last = showlast, style = plot.style_stepline)
// Low-Close: Anchored to Close (Upper) and Low (Lower)
plot(showLC ? sec_cs + lc_stdevs : na, title="s LC Upper (Close Anchor)", color=color.teal, show_last = showlast, style = plot.style_stepline)
plot(showLC ? sec_cm + lc_stdevm : na, title="m LC Upper (Close Anchor)", color=color.teal, show_last = showlast, style = plot.style_stepline)
plot(showLC ? sec_cl + lc_stdevl : na, title="l LC Upper (Close Anchor)", color=color.teal, show_last = showlast, style = plot.style_stepline)
// plot(showLC ? sec_l - lc_stdev : na, title="LC Lower (Low Anchor)", color=color.teal, style = plot.style_stepline)

// Close-Open: Reverse Logic Anchors for Variation
plot(showCO ? sec_cs + co_stdevs : na, title="s CO Upper (Close Anchor)", color=color.green, show_last = showlast, style = plot.style_stepline)
plot(showCO ? sec_cm + co_stdevm : na, title="m CO Upper (Close Anchor)", color=color.green, show_last = showlast, style = plot.style_stepline)
plot(showCO ? sec_cl + co_stdevl : na, title="l CO Upper (Close Anchor)", color=color.green, show_last = showlast, style = plot.style_stepline)
plot(showCO ? sec_os - co_stdevs : na, title="s CO Lower (Open Anchor)", color=color.maroon, show_last = showlast, style = plot.style_stepline)
plot(showCO ? sec_om - co_stdevm : na, title="m CO Lower (Open Anchor)", color=color.maroon, show_last = showlast, style = plot.style_stepline)
plot(showCO ? sec_ol - co_stdevl : na, title="l CO Lower (Open Anchor)", color=color.maroon, show_last = showlast, style = plot.style_stepline)



h_i = input.int(100)
l_i = input.int(100)
h_ = ta.highest(h_i)
l_ = ta.lowest(l_i)
plot(h_)
plot(l_)



