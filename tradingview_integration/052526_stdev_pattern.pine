// --- 0. UDT WRAPPER FOR 2D CHART POINTS (FIXES COLLECTION ERROR) ---
type PointArray
    array<chart.point> pts

type HTFContext
    string tf
    box    displayBox

// --- AlphaTrend Core ---
g_alp = "AlphaTrend Core Engines"
b_cf  = input.float(1.5, 'Base Volatility Coeff', step=0.1, group=g_alp)
al_pr = input.int(14, 'Common Period', group=g_alp)
al_sr = input.source(close, 'Source Data', group=g_alp)

// --- Multi-Timeframe Structure ---
g_htf = "Multi-Timeframe Structure"
hf_in = input.timeframe("15", "HTF Background Box", group=g_htf)

