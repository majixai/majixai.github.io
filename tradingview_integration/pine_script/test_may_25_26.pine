var PinnedForecast  pf   = PinnedForecast.new(0, 0, 0.0, array.new_float(0), array.new_float(0), array.new_float(0), array.new_float(0), array.new_float(0), 0, false, "NONE")
var AccuracyEngine  acc  = AccuracyEngine.new(0, 0, 0.5, 0.5, 1.0)
