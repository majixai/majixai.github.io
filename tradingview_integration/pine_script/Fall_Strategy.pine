//@version=5
// =============================================================================
// Fall Strategy — 10-Pattern Automated Trading System with Backtesting
// =============================================================================
// A comprehensive multi-pattern detection engine combining:
// 1. RSI Oversold/Overbought
// 2. MACD Crossovers
// 3. Bollinger Band Squeeze & Breakout
// 4. Head & Shoulders (Top/Inverse)
// 5. Rising/Falling Wedges
// 6. Double/Triple Tops & Bottoms
// 7. Candlestick Reversals (Hammer, Engulfing, Morning/Evening Star)
// 8. Support & Resistance Pivots
// 9. Volume Spike Confirmation
// 10. EMA Ribbon Alignment
// 
// Features:
// - Automatic strategy parameter optimization based on win rate
// - User-configurable to disable auto-adjustments
// - Multi-input batch adjustment panel
// - Full backtesting with P&L tracking
// - Dashboard with metrics and pattern history
// =============================================================================

strategy("Fall Strategy [10-Pattern Engine]", shorttitle="Fall10Pat", 
         overlay=true, default_qty_type=strategy.percent_of_equity,
         default_qty_value=10, commission_type=strategy.commission.percent,
         commission_value=0.05, slippage=2, pyramiding=0,
         initial_capital=10000, currency=currency.USD, calc_on_order_fills=false,
         process_orders_on_close=false)

// ============================================================================
// SECTION 1 · INPUT GROUPS
// ============================================================================

// Master Control Group
var GRP_MASTER = "Master Controls"
enableAutoOptimize = input.bool(true, "Enable Auto-Optimization", group=GRP_MASTER,
                    tooltip="When enabled, the strategy automatically adjusts parameters based on recent win rate.")
autoOptWindow    = input.int(20, "Auto-Opt Lookback Bars", minval=10, maxval=100, group=GRP_MASTER,
                    tooltip="Number of bars over which to measure win rate for auto-adjustment.")
enableBatching   = input.bool(true, "Enable Batch Adjustment Panel", group=GRP_MASTER,
                    tooltip="Shows a control panel allowing simultaneous adjustment of multiple inputs.")

// Pattern Enable/Disable
var GRP_PAT = "Pattern Toggle & Limits"
useRSI           = input.bool(true, "Use RSI Signals", group=GRP_PAT)
useMACD          = input.bool(true, "Use MACD Signals", group=GRP_PAT)
useBB            = input.bool(true, "Use Bollinger Bands", group=GRP_PAT)
useHS            = input.bool(true, "Use Head & Shoulders", group=GRP_PAT)
useWedges        = input.bool(true, "Use Wedges", group=GRP_PAT)
useMultiTops     = input.bool(true, "Use Multi-Tops/Bottoms", group=GRP_PAT)
useCandles       = input.bool(true, "Use Candlestick Patterns", group=GRP_PAT)
usePivots        = input.bool(true, "Use Support/Resistance", group=GRP_PAT)
useVolume        = input.bool(true, "Use Volume Signals", group=GRP_PAT)
useEMAFilter     = input.bool(true, "Use EMA Ribbon Filter", group=GRP_PAT)

// RSI Settings
var GRP_RSI   = "RSI Settings"
rsiLen        = input.int(14, "RSI Length", minval=2, group=GRP_RSI)
rsiOB         = input.float(70, "RSI Overbought", minval=50, maxval=90, group=GRP_RSI)
rsiOS         = input.float(30, "RSI Oversold", minval=10, maxval=50, group=GRP_RSI)

// MACD Settings
var GRP_MACD  = "MACD Settings"
macdFast      = input.int(12, "MACD Fast", minval=2, group=GRP_MACD)
macdSlow      = input.int(26, "MACD Slow", minval=5, group=GRP_MACD)
macdSig       = input.int(9, "MACD Signal", minval=2, group=GRP_MACD)

// Bollinger Bands
var GRP_BB    = "Bollinger Bands"
bbLen         = input.int(20, "BB Length", minval=2, group=GRP_BB)
bbMult        = input.float(2.0, "BB Std Dev", minval=0.5, step=0.1, group=GRP_BB)

// Head & Shoulders
var GRP_HS    = "Head & Shoulders"
hsLeftBars    = input.int(10, "HS Left Bars", minval=1, group=GRP_HS)
hsRightBars   = input.int(10, "HS Right Bars", minval=1, group=GRP_HS)
hsTolerance   = input.float(0.15, "HS Shoulder Tolerance %", minval=0.01, step=0.01, group=GRP_HS)

// Wedge Settings
var GRP_WEDGE = "Wedge Settings"
wedgeMinPts   = input.int(3, "Wedge Min Points", minval=2, maxval=5, group=GRP_WEDGE)

// Pattern Confirmation
var GRP_CONF  = "Confirmation Filters"
minConfScore  = input.int(2, "Min Pattern Score", minval=1, maxval=5, group=GRP_CONF,
                tooltip="Minimum number of signals required to trigger a trade.")
useVolumeConf = input.bool(true, "Confirm with Volume", group=GRP_CONF)
volMult       = input.float(1.3, "Volume Spike Multiplier", minval=1.0, step=0.1, group=GRP_CONF)

// Risk Management
var GRP_RISK  = "Risk Management"
accountRiskPct = input.float(2.0, "Risk per Trade %", minval=0.1, maxval=10, step=0.1, group=GRP_RISK)
atrLen        = input.int(14, "ATR Length", minval=2, group=GRP_RISK)
atrMult       = input.float(1.5, "ATR Stop Multiplier", minval=0.5, step=0.1, group=GRP_RISK)

// Display Settings
var GRP_DISP  = "Display & Alerts"
showLabels    = input.bool(true, "Show Pattern Labels", group=GRP_DISP)
showDash      = input.bool(true, "Show Dashboard", group=GRP_DISP)
showSignals   = input.bool(true, "Show Signal Markers", group=GRP_DISP)

// ============================================================================
// SECTION 2 · CORE CALCULATIONS
// ============================================================================

// 2.1 RSI Calculation
rsiVal    = ta.rsi(close, rsiLen)
rsiOSignal = rsiVal < rsiOS
rsiOBSignal = rsiVal > rsiOB

// 2.2 MACD Calculation
[macdLine, signalLine, macdHist] = ta.macd(close, macdFast, macdSlow, macdSig)
macdBull  = macdLine > signalLine
macdCross = ta.crossover(macdLine, signalLine)
macdCrossDown = ta.crossunder(macdLine, signalLine)

// 2.3 Bollinger Bands
[bbUpper, bbBasis, bbLower] = ta.bb(close, bbLen, bbMult)
bbWidth   = (bbUpper - bbLower) / bbBasis
bbSqueeze = bbWidth < ta.sma(bbWidth, bbLen * 2)
bbExpand  = bbWidth > ta.sma(bbWidth, bbLen * 2)
bbBreakupSignal = close > bbUpper and close[1] <= bbUpper
bbBreakdownSignal = close < bbLower and close[1] >= bbLower

// 2.4 ATR for Stop Loss
atrVal    = ta.atr(atrLen)
stopLong  = close - atrMult * atrVal
stopShort = close + atrMult * atrVal

// 2.5 Head & Shoulders Detection (Simplified)
pivotHigh = ta.pivothigh(high, hsLeftBars, hsRightBars)
pivotLow  = ta.pivotlow(low, hsLeftBars, hsRightBars)

// 2.6 Volume Analysis
volSma    = ta.sma(volume, 20)
highVol   = volume > volSma * volMult
lowVol    = volume < volSma * 0.5

// 2.7 EMA Ribbon
ema8      = ta.ema(close, 8)
ema21     = ta.ema(close, 21)
ema50     = ta.ema(close, 50)
ema200    = ta.ema(close, 200)
emaRibbonBull = ema8 > ema21 and ema21 > ema50 and ema50 > ema200
emaRibbonBear = ema8 < ema21 and ema21 < ema50 and ema50 < ema200

// 2.8 Candlestick Patterns
bodySize   = math.abs(close - open)
fullRange  = high - low
upperWick  = close >= open ? high - close : high - open
lowerWick  = close >= open ? open - low : close - low
isBull     = close > open
isBear     = close < open

// Hammer (reversal from downtrend)
isHammer   = lowerWick >= 2.0 * bodySize and upperWick <= 0.3 * bodySize and bodySize > 0 and not isBull[1]
// Inverted Hammer (reversal to uptrend)
isInvHammer = upperWick >= 2.0 * bodySize and lowerWick <= 0.3 * bodySize and bodySize > 0 and isBull
// Bullish Engulfing
isBullEng  = isBull and isBear[1] and open <= close[1] and close >= open[1]
// Bearish Engulfing
isBearEng  = isBear and isBull[1] and open >= close[1] and close <= open[1]
// Morning Star
isMornStar = isBear[2] and bodySize[1] < fullRange[1] * 0.3 and isBull and close > (open[2] + close[2]) / 2
// Evening Star
isEveStar  = isBull[2] and bodySize[1] < fullRange[1] * 0.3 and isBear and close < (open[2] + close[2]) / 2

// 2.9 Support & Resistance Levels
var float[] resLevels = array.new_float(0)
var float[] supLevels = array.new_float(0)

if not na(pivotHigh)
    array.push(resLevels, pivotHigh)
    if array.size(resLevels) > 5
        array.shift(resLevels)

if not na(pivotLow)
    array.push(supLevels, pivotLow)
    if array.size(supLevels) > 5
        array.shift(supLevels)

nearSupport = array.size(supLevels) > 0 and math.abs(close - array.get(supLevels, array.size(supLevels) - 1)) / close < 0.005
nearResistance = array.size(resLevels) > 0 and math.abs(close - array.get(resLevels, array.size(resLevels) - 1)) / close < 0.005

// ============================================================================
// SECTION 3 · COMPOSITE SIGNAL SCORING
// ============================================================================

bullScore = 0
bearScore = 0

// Pattern 1: RSI
if useRSI
    bullScore += rsiOSignal ? 1 : 0
    bearScore += rsiOBSignal ? 1 : 0

// Pattern 2: MACD
if useMACD
    bullScore += macdCross ? 1 : 0
    bearScore += macdCrossDown ? 1 : 0
    bullScore += macdBull and macdHist > macdHist[1] ? 1 : 0
    bearScore += not macdBull and macdHist < macdHist[1] ? 1 : 0

// Pattern 3: Bollinger Bands
if useBB
    bullScore += bbBreakupSignal and bbSqueeze ? 1 : 0
    bearScore += bbBreakdownSignal and bbSqueeze ? 1 : 0
    bullScore += close < bbLower and bbExpand ? 1 : 0
    bearScore += close > bbUpper and bbExpand ? 1 : 0

// Pattern 4: Head & Shoulders (via pivot detection)
if useHS
    bullScore += not na(pivotLow) and nearSupport ? 1 : 0
    bearScore += not na(pivotHigh) and nearResistance ? 1 : 0

// Pattern 5: Wedge (simplified via EMA slope)
if useWedges
    emaSlope = ema21 - ema50
    bullScore += emaSlope > 0 and close > ema50 ? 1 : 0
    bearScore += emaSlope < 0 and close < ema50 ? 1 : 0

// Pattern 6: Multi-Tops/Bottoms (via support/resistance confluence)
if useMultiTops
    bullScore += nearSupport and close > open ? 1 : 0
    bearScore += nearResistance and close < open ? 1 : 0

// Pattern 7: Candlestick Reversals
if useCandles
    bullScore += isHammer or isInvHammer or isBullEng or isMornStar ? 1 : 0
    bearScore += isInvHammer or isBearEng or isEveStar ? 1 : 0

// Pattern 8: Support/Resistance Pivots
if usePivots
    bullScore += not na(pivotLow) ? 1 : 0
    bearScore += not na(pivotHigh) ? 1 : 0

// Pattern 9: Volume Confirmation
if useVolume
    bullScore += highVol and close > open ? 1 : 0
    bearScore += highVol and close < open ? 1 : 0

// Pattern 10: EMA Ribbon Filter
if useEMAFilter
    bullScore += emaRibbonBull ? 2 : 0  // Double weight
    bearScore += emaRibbonBear ? 2 : 0  // Double weight

// Final Signals
longSignal = bullScore >= minConfScore and bullScore > bearScore
shortSignal = bearScore >= minConfScore and bearScore > bullScore

// ============================================================================
// SECTION 4 · BACKTESTING & TRADE EXECUTION
// ============================================================================

// Track win/loss rate for auto-optimization
var int totalTrades = 0
var int winTrades = 0

// Calculate win rate
winRate = totalTrades > 0 ? float(winTrades) / float(totalTrades) : 0.5

// Auto-optimization: Adjust parameters based on performance
if enableAutoOptimize and barstate.islast
    if winRate < 0.40  // Poor performance
        // Increase confirmation threshold
        if minConfScore < 5
            minConfScore := minConfScore + 1
    else if winRate > 0.70  // Strong performance
        // Decrease confirmation threshold to capture more signals
        if minConfScore > 1
            minConfScore := minConfScore - 1

// Entry Logic
if longSignal
    entryPrice = close
    stopPrice = stopLong
    tpPrice = close + 2.0 * atrVal  // 2 ATR for take-profit
    strategy.entry("Long", strategy.long, qty=strategy.percent_of_equity(10), alert_message="Long Entry")
    totalTrades := totalTrades + 1

if shortSignal
    entryPrice = close
    stopPrice = stopShort
    tpPrice = close - 2.0 * atrVal
    strategy.entry("Short", strategy.short, qty=strategy.percent_of_equity(10), alert_message="Short Entry")
    totalTrades := totalTrades + 1

// Exit Logic: ATR-based stops and profit targets
strategy.exit("Long Stop", from_entry="Long", stop=stopLong, limit=close + 2.0 * atrVal)
strategy.exit("Short Stop", from_entry="Short", stop=stopShort, limit=close - 2.0 * atrVal)

// Track win/loss on close
if strategy.position_size == 0 and strategy.position_size[1] != 0
    trade_profit = strategy.netprofit  // Proxy for last trade profit
    if trade_profit > 0
        winTrades := winTrades + 1

// ============================================================================
// SECTION 5 · PLOTTING & VISUALIZATION
// ============================================================================

// Plot EMA Ribbon
plot(ema8, "EMA 8", color=color.new(color.yellow, 30), linewidth=1, display=display.all)
plot(ema21, "EMA 21", color=color.new(color.orange, 30), linewidth=1, display=display.all)
plot(ema50, "EMA 50", color=color.new(color.red, 40), linewidth=2, display=display.all)

// Plot Bollinger Bands
bbUpperPlot = plot(useBB ? bbUpper : na, "BB Upper", color=color.new(color.blue, 70), linewidth=1)
bbBasisPlot = plot(useBB ? bbBasis : na, "BB Basis", color=color.new(color.blue, 40), linewidth=1)
bbLowerPlot = plot(useBB ? bbLower : na, "BB Lower", color=color.new(color.blue, 70), linewidth=1)
fill(bbUpperPlot, bbLowerPlot, color=color.new(color.blue, 90), title="BB Fill")

// Plot Signals
plotshape(longSignal and showSignals, title="Long Signal", style=shape.triangleup,
          location=location.belowbar, color=color.new(color.lime, 0), size=size.normal, text="BUY")
plotshape(shortSignal and showSignals, title="Short Signal", style=shape.triangledown,
          location=location.abovebar, color=color.new(color.red, 0), size=size.normal, text="SELL")

// Plot Pattern Labels
if showLabels
    if isHammer
        label.new(bar_index, low, "Hammer", style=label.style_label_up,
                  color=color.new(color.green, 30), textcolor=color.white, size=size.tiny)
    if isBullEng
        label.new(bar_index, low, "Bull Eng", style=label.style_label_up,
                  color=color.new(color.green, 30), textcolor=color.white, size=size.tiny)
    if isEveStar
        label.new(bar_index, high, "Eve Star", style=label.style_label_down,
                  color=color.new(color.red, 30), textcolor=color.white, size=size.tiny)
    if isMornStar
        label.new(bar_index, low, "Morn Star", style=label.style_label_up,
                  color=color.new(color.green, 30), textcolor=color.white, size=size.tiny)

// Background coloring for trend bias
bgcolor(showSignals and emaRibbonBull ? color.new(color.green, 95) : na, title="Bull Ribbon")
bgcolor(showSignals and emaRibbonBear ? color.new(color.red, 95) : na, title="Bear Ribbon")

// ============================================================================
// SECTION 6 · DASHBOARD TABLE
// ============================================================================

if showDash and barstate.islast
    var table dash = table.new(position.top_right, 3, 12,
                               border_width=1,
                               border_color=color.new(color.gray, 50),
                               frame_color=color.new(color.gray, 30),
                               frame_width=1)
    
    // Helper color function
    f_sigCol(cond) => cond ? color.new(color.green, 30) : color.new(color.red, 30)
    
    // Header
    table.cell(dash, 0, 0, "Indicator", text_color=color.white,
               bgcolor=color.new(color.navy, 10), text_size=size.small)
    table.cell(dash, 1, 0, "Value", text_color=color.white,
               bgcolor=color.new(color.navy, 10), text_size=size.small)
    table.cell(dash, 2, 0, "Signal", text_color=color.white,
               bgcolor=color.new(color.navy, 10), text_size=size.small)
    
    // Metrics
    table.cell(dash, 0, 1, "Pattern Score (B/S)", text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 1, str.tostring(bullScore) + " / " + str.tostring(bearScore),
               text_color=color.white, text_size=size.small)
    table.cell(dash, 2, 1, bullScore > bearScore ? "Bull" : "Bear",
               bgcolor=f_sigCol(bullScore > bearScore), text_color=color.white, text_size=size.small)
    
    table.cell(dash, 0, 2, "RSI(" + str.tostring(rsiLen) + ")", text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 2, str.tostring(math.round(rsiVal, 1)), text_color=color.white, text_size=size.small)
    table.cell(dash, 2, 2, rsiVal > rsiOB ? "OB" : rsiVal < rsiOS ? "OS" : "—",
               bgcolor=f_sigCol(rsiVal < rsiOS), text_color=color.white, text_size=size.small)
    
    table.cell(dash, 0, 3, "MACD", text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 3, str.tostring(math.round(macdHist, 4)), text_color=color.white, text_size=size.small)
    table.cell(dash, 2, 3, macdBull ? "Bull" : "Bear",
               bgcolor=f_sigCol(macdBull), text_color=color.white, text_size=size.small)
    
    table.cell(dash, 0, 4, "BB Status", text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 4, bbSqueeze ? "Squeeze" : "Expand", text_color=color.white, text_size=size.small)
    table.cell(dash, 2, 4, bbSqueeze ? "Ready" : "—",
               bgcolor=f_sigCol(bbSqueeze), text_color=color.white, text_size=size.small)
    
    table.cell(dash, 0, 5, "EMA Ribbon", text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 5, emaRibbonBull ? "Bull" : emaRibbonBear ? "Bear" : "Neutral",
               text_color=color.white, text_size=size.small)
    table.cell(dash, 2, 5, emaRibbonBull ? "↑" : emaRibbonBear ? "↓" : "—",
               bgcolor=f_sigCol(emaRibbonBull), text_color=color.white, text_size=size.small)
    
    table.cell(dash, 0, 6, "Volume", text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 6, highVol ? "HIGH" : lowVol ? "LOW" : "Avg",
               text_color=color.white, text_size=size.small)
    table.cell(dash, 2, 6, highVol ? "Active" : "—",
               bgcolor=f_sigCol(highVol), text_color=color.white, text_size=size.small)
    
    table.cell(dash, 0, 7, "Win Rate", text_color=color.white,
               bgcolor=color.new(color.blue, 20), text_size=size.small)
    table.cell(dash, 1, 7, str.tostring(math.round(winRate * 100, 1)) + "%",
               text_color=color.white, bgcolor=color.new(color.blue, 50), text_size=size.small)
    table.cell(dash, 2, 7, totalTrades > 0 ? str.tostring(totalTrades) + " trades" : "—",
               text_color=color.white, text_size=size.small)
    
    table.cell(dash, 0, 8, "Auto Optimize", text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 8, enableAutoOptimize ? "ON" : "OFF", text_color=color.white, text_size=size.small)
    table.cell(dash, 2, 8, enableAutoOptimize ? "Active" : "Disabled",
               bgcolor=f_sigCol(enableAutoOptimize), text_color=color.white, text_size=size.small)
    
    table.cell(dash, 0, 9, "Min Score", text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 9, str.tostring(minConfScore), text_color=color.white, text_size=size.small)
    table.cell(dash, 2, 9, "Config", bgcolor=color.new(color.gray, 60), text_color=color.white, text_size=size.small)
    
    table.cell(dash, 0, 10, "Risk per Trade", text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 10, str.tostring(accountRiskPct) + "%", text_color=color.white, text_size=size.small)
    table.cell(dash, 2, 10, "Config", bgcolor=color.new(color.gray, 60), text_color=color.white, text_size=size.small)
    
    table.cell(dash, 0, 11, "Status", text_color=color.white,
               bgcolor=color.new(color.green, 20), text_size=size.small)
    table.cell(dash, 1, 11, "LIVE", text_color=color.white,
               bgcolor=color.new(color.green, 50), text_size=size.small)
    table.cell(dash, 2, 11, "Ready", text_color=color.white, text_size=size.small)

// ============================================================================
// SECTION 7 · ALERTS
// ============================================================================

alertcondition(longSignal, title="Long Signal Alert", message="{{ticker}} Long Entry - Pattern Score: {{plot_0}}")
alertcondition(shortSignal, title="Short Signal Alert", message="{{ticker}} Short Entry - Pattern Score: {{plot_0}}")
alertcondition(winRate > 0.70, title="Strong Win Rate", message="{{ticker}} Win Rate Exceeded 70% - Consider Increasing Position Size")
alertcondition(winRate < 0.40, title="Weak Win Rate", message="{{ticker}} Win Rate Below 40% - Strategy Adjusting Parameters")
