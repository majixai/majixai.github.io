csh(x,sc)=>
    ea=math.max(-20.0,math.min(20.0,sc*x))
    e=math.exp(ea)
    (e+1.0/e)*0.5
dlr(x,w)=>
    w>0.0?1.0/(math.pi*w*(1.0+(x/w)*(x/w))):0.0
skz(r,bm,rm,ln)=>
    ag=ta.sma(r,ln)
    sg=ta.stdev(r,ln)
    z=sg>MSD?(r-ag)/sg:0.0
    z>=0.0?z*bm:z*rm
lrs(src,ln)=>
    float sx=0.0
    float sy=0.0
    float sxy=0.0
    float sx2=0.0
    for i=0 to ln-1
        xi=float(ln-1-i)
        yi=nz(src[i])
        sx+=xi
        sy+=yi
        sxy+=xi*yi
        sx2+=xi*xi
    n=float(ln)
    det=n*sx2-sx*sx
    sl=det!=0.0?(n*sxy-sx*sy)/det:0.0
    ic=(sy-sl*sx)/n
    ym=sy/n
    float st=0.0
    float sr=0.0
    for i=0 to ln-1
        xi=float(ln-1-i)
        yi=nz(src[i])
        yh=sl*xi+ic
        st+=(yi-ym)*(yi-ym)
        sr+=(yi-yh)*(yi-yh)
    r2=st>MSD?math.max(0.0,1.0-sr/st):0.0
    se=ln>2?math.sqrt(sr/(n-2.0)):0.0
    [sl,ic,r2,se]
pc2(src,ln)=>
    a=ta.linreg(src,ln,0)
    b=ta.linreg(src,ln,1)
    c=ta.linreg(src,ln,2)
    (a-b)-(b-c)
pc3(src,ln)=>
    a=ta.linreg(src,ln,0)
    b=ta.linreg(src,ln,1)
    c=ta.linreg(src,ln,2)
    d=ta.linreg(src,ln,3)
    ac0=(a-b)-(b-c)
    ac1=(b-c)-(c-d)
    ac0-ac1

