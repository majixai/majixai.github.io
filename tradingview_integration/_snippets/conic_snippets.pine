                string tip = "Warped Mean: " + str.tostring(warpTP,"#.##") +
                             "\nBounds: [" + str.tostring(rawDn-bayDev,"#.##") + " – " + str.tostring(rawUp+bayDev,"#.##") + "]" +
                             "\nStatus: " + (isHit ? "HIT ✓" : "MISS ✗")
                label nodeLbl = label.new(tBar, warpTP, "", color=isHit?color.new(#00FFAA,20):color.new(#FF0055,20),
                                          style=label.style_circle, size=size.tiny, tooltip=tip)
                push_label_capped(fcstLabels, nodeLbl, liveCapFcstLabels)

        array<chart.point> ribbonPts = array.new<chart.point>()
        for p in ptsUpper
            array.push(ribbonPts, p)
        for i = array.size(ptsLower) - 1 to 0
            array.push(ribbonPts, array.get(ptsLower, i))

        push_polyline_capped(fcstShapes, polyline.new(ribbonPts, closed=true, fill_color=color.new(tfColor,85), line_color=na, xloc=xloc.bar_time), liveCapFcstShapes)
        push_polyline_capped(mainPoly, polyline.new(ptsMean,  curved=curvP, line_color=tfColor,                  line_width=2, line_style=line.style_dashed, xloc=xloc.bar_time), liveCapMainPoly)
        push_polyline_capped(mainPoly, polyline.new(ptsUpper, curved=curvP, line_color=color.new(tfColor,40),    line_width=1, line_style=line.style_dotted, xloc=xloc.bar_time), liveCapMainPoly)
        push_polyline_capped(mainPoly, polyline.new(ptsLower, curved=curvP, line_color=color.new(tfColor,40),    line_width=1, line_style=line.style_dotted, xloc=xloc.bar_time), liveCapMainPoly)
        push_polyline_capped(mc_lines, polyline.new(ptsConic, curved=true,  line_color=color.new(#B200FF,50),    line_width=2, xloc=xloc.bar_time), liveCapMcLines)

