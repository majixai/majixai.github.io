// Source (origin/main): tradingview_integration/pine_script/differentiated_conic_projection_engine.pine#L423-L450
update_conic_parameters(matrix<float> mat, float v0, float a, float errTerm, int steps) =>
    int maxSteps = math.min(steps, matrix.columns(mat))
    float den = math.max(1.0, maxSteps - 1.0)
    for i = 0 to maxSteps - 1
        float x = i
        float sq = math.sqrt(math.max(1.0, x))
        float t = i / den
        // Differentiated conic math:
        // Path A (Ballistic): amplified acceleration and positive convexity.
        // Path B (Diffusive): flatter trajectory with reduced curvature and gentler drift.
        // Path C (Mean-Reverting): counter-curvature plus sinusoidal correction toward equilibrium.
        // These are separate price equations, not time-shifted copies of one base path.
        float y_ballistic = (a * 1.35 * math.pow(x, 2)) + (v0 * 1.18 * x) + (errTerm * 1.25 * sq) + (errTerm * 6.0 * t * (1.0 - t))
        float y_diffusive = (a * 0.90 * math.pow(x, 2)) + (v0 * 0.96 * x) + (errTerm * 0.75 * sq) - (errTerm * 2.2 * t * (1.0 - t))
        float y_meanRev   = (a * 0.62 * math.pow(x, 2)) + (v0 * 0.78 * x) - (errTerm * 1.05 * sq) + (errTerm * 3.5 * math.sin(math.pi * t))
        matrix.set(mat, 0, i, y_ballistic)
        matrix.set(mat, 1, i, y_diffusive)
        matrix.set(mat, 2, i, y_meanRev)
        matrix.set(mat, 3, i, y_ballistic + (errTerm * 1.10 * sq))
        matrix.set(mat, 4, i, y_ballistic - (errTerm * 1.10 * sq))
        matrix.set(mat, 5, i, y_diffusive + (errTerm * 0.90 * sq))
        matrix.set(mat, 6, i, y_diffusive - (errTerm * 0.90 * sq))
        matrix.set(mat, 7, i, y_meanRev + (errTerm * 1.30 * sq))
        matrix.set(mat, 8, i, y_meanRev - (errTerm * 1.30 * sq))

render_parametric_bounds(matrix<float> mat, int start_x, float start_y, int steps, color col, float stress01) =>
    int render_step = stress01 > 0.7 ? 4 : (stress01 > 0.4 ? 2 : 1)
    int maxSteps = math.min(steps, matrix.columns(mat))

