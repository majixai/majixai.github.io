// Source (origin/main): tradingview_integration/pine_script/jinx.pine#L423-L450
update_conic_parameters(matrix<float> mat, float v0, float a, float errTerm, int steps) =>
    int maxSteps = math.min(steps, matrix.columns(mat))
    for i = 0 to maxSteps - 1
        float x = i
        float sq = math.sqrt(math.max(1.0, x))
        float y_center = (a * math.pow(x, 2)) + (v0 * x)
        float y_upper = y_center + (errTerm * sq)
        float y_lower = y_center - (errTerm * sq)
        matrix.set(mat, 0, i, a)
        matrix.set(mat, 1, i, v0)
        matrix.set(mat, 2, i, y_upper)
        matrix.set(mat, 3, i, a)
        matrix.set(mat, 4, i, v0)
        matrix.set(mat, 5, i, y_lower)

render_parametric_bounds(matrix<float> mat, int start_x, float start_y, int steps, color col, float stress01) =>
    int render_step = stress01 > 0.7 ? 4 : (stress01 > 0.4 ? 2 : 1)
    int maxSteps = math.min(steps, matrix.columns(mat))
    array<chart.point> upper_pts = array.new<chart.point>()
    array<chart.point> lower_pts = array.new<chart.point>()
    for i = 0 to maxSteps - 1 by render_step
        float upper_val = start_y + matrix.get(mat, 2, i)
        float lower_val = start_y + matrix.get(mat, 5, i)
        array.push(upper_pts, chart.point.from_index(start_x + i, upper_val))
        array.push(lower_pts, chart.point.from_index(start_x + i, lower_val))
    if array.size(upper_pts) > 1
        push_polyline_capped(fcstShapes, polyline.new(upper_pts, curved=curvP, line_color=col, line_width=2, xloc=xloc.bar_index), liveCapFcstShapes)
        push_polyline_capped(fcstShapes, polyline.new(lower_pts, curved=curvP, line_color=col, line_width=2, xloc=xloc.bar_index), liveCapFcstShapes)

