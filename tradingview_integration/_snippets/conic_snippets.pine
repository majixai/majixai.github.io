g_kn    = "Kinematic Ensemble"
tf_sh   = input.timeframe("5",   "Short  Conic TF",   group=g_kn, tooltip="Timeframe for the fast/short-term conic model. Must be ≥ chart TF.")
tf_md   = input.timeframe("15",  "Medium Conic TF",   group=g_kn, tooltip="Timeframe for the medium-term conic model. Must be ≥ chart TF.")
tf_lg   = input.timeframe("60",  "Long   Conic TF",   group=g_kn, tooltip="Timeframe for the slow/long-term conic model. Must be ≥ chart TF.")
kn_lb_s = input.int(10,  "Short  Conic LB",  minval=5,  maxval=50,  group=g_kn, tooltip="OLS regression lookback bars on the short TF.")
kn_lb_m = input.int(20,  "Medium Conic LB",  minval=5,  maxval=100, group=g_kn, tooltip="OLS regression lookback bars on the medium TF.")
kn_lb_l = input.int(40,  "Long   Conic LB",  minval=10, maxval=200, group=g_kn, tooltip="OLS regression lookback bars on the long TF.")
by_hz   = input.int(20,     'Bayesian Horizon Offset', minval=2, maxval=100, group=g_kn, tooltip="Historical bar offset used by Bayesian inference accuracy check.")
lr_rt   = input.float(0.1,  'Feedback Learn Rate',     minval=0.01, maxval=0.5, group=g_kn, tooltip="Speed at which Bayesian bias adapts to forecast errors.")
