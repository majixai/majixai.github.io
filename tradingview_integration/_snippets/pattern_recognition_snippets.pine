var bool hs=false
var bool ihs=false
var float hn=na
var float ihn=na
var int hbb=na
var int ibb=na
hs:=false
ihs:=false
if array.size(pha)>=3
    rs=array.get(pha,0)
    hd=array.get(pha,1)
    ls=array.get(pha,2)
    nk=(ls+rs)*0.5
    cl=hd>nk*(1.0+iNT)
    sd=math.max(ls,rs)
    sk=sd>0.0 and math.abs(ls-rs)/sd<iSS
    if cl and sk and close<nk*(1.0-iNT)
        hs:=true
        hn:=nk
        hbb:=bar_index
if array.size(pla)>=3
    rs=array.get(pla,0)
    hd=array.get(pla,1)
    ls=array.get(pla,2)
    nk=(ls+rs)*0.5
    cl=hd<nk*(1.0-iNT)
    sd=math.min(ls,rs)
    sk=sd>0.0 and math.abs(ls-rs)/sd<iSS
    if cl and sk and close>nk*(1.0+iNT)
        ihs:=true
        ihn:=nk
        ibb:=bar_index
var bool dts=false
var bool dbs=false
var float dtn=na
var float dbn=na
dts:=false
dbs:=false
if array.size(pha)>=2
    t1=array.get(pha,0)
    t2=array.get(pha,1)
    ta2=(t1+t2)*0.5
    if ta2>0.0 and math.abs(t1-t2)/ta2<iDTT
        vlo=ta.lowest(low,iDTL)
        vd=ta2>0.0?(ta2-vlo)/ta2:0.0
        if vd>=iDMD and close<vlo*(1.0-iNT)
            dts:=true
            dtn:=vlo
if array.size(pla)>=2
    b1=array.get(pla,0)
    b2=array.get(pla,1)
    ba2=(b1+b2)*0.5
    if ba2>0.0 and math.abs(b1-b2)/ba2<iDTT
        phi2=ta.highest(high,iDTL)
        pd2=ba2>0.0?(phi2-ba2)/ba2:0.0
        if pd2>=iDMD and close>phi2*(1.0+iNT)
            dbs:=true
            dbn:=phi2
rts=not na(hbb) and (bar_index-hbb)<=iRTB and not na(hn) and close>=hn*(1.0-iNT*2.0) and close<=hn*(1.0+iNT*2.0)
rtl=not na(ibb) and (bar_index-ibb)<=iRTB and not na(ihn) and close>=ihn*(1.0-iNT*2.0) and close<=ihn*(1.0+iNT*2.0)

