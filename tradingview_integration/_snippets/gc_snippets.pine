const int CAP_GHOST_BOXES   = 120
const int CAP_GHOST_WICKS   = 120
const int CAP_MC_LINES      = 80
const int CAP_DENS_BOXES    = 40
const int CAP_FCST_SHAPES   = 40
const int CAP_FCST_LABELS   = 120
const int CAP_MAIN_POLY     = 120
const int PRUNE_BATCH       = 30
const int CAP_MIN_GHOST_BOXES = 40
const int CAP_MIN_GHOST_WICKS = 40
const int CAP_MIN_MC_LINES    = 24
const int CAP_MIN_DENS_BOXES  = 16
const int CAP_MIN_FCST_SHAPES = 16
const int CAP_MIN_FCST_LABELS = 40
const int CAP_MIN_MAIN_POLY   = 40
var int liveCapGhostBoxes = CAP_GHOST_BOXES
var int liveCapGhostWicks = CAP_GHOST_WICKS
var int liveCapMcLines    = CAP_MC_LINES
var int liveCapDensBoxes  = CAP_DENS_BOXES
var int liveCapFcstShapes = CAP_FCST_SHAPES
var int liveCapFcstLabels = CAP_FCST_LABELS
var int liveCapMainPoly   = CAP_MAIN_POLY

// -----------------------------------------------------------------------------
// Source (origin/main): tradingview_integration/pine_script/differentiated_conic_projection_engine.pine#L389-L412
manage_draw_resources(float stress01, int pruneBatch) =>
    float s = math.max(0.0, math.min(1.0, stress01))
    
    // Calculate how many extra items to prune based on stress
    int extraOps = int(math.round(pruneBatch * s))
    int ops      = pruneBatch + extraOps

    // Calculate dynamic caps
    int liveCapGhostBoxes  = calc_dynamic_cap(CAP_GHOST_BOXES,  CAP_MIN_GHOST_BOXES,  s)
    int liveCapGhostWicks  = calc_dynamic_cap(CAP_GHOST_WICKS,  CAP_MIN_GHOST_WICKS,  s)
    int liveCapMcLines     = calc_dynamic_cap(CAP_MC_LINES,     CAP_MIN_MC_LINES,     s)
    int liveCapDensBoxes   = calc_dynamic_cap(CAP_DENS_BOXES,   CAP_MIN_DENS_BOXES,   s)
    int liveCapFcstShapes  = calc_dynamic_cap(CAP_FCST_SHAPES,  CAP_MIN_FCST_SHAPES,  s)
    int liveCapFcstLabels  = calc_dynamic_cap(CAP_FCST_LABELS,  CAP_MIN_FCST_LABELS,  s)
    int liveCapMainPoly    = calc_dynamic_cap(CAP_MAIN_POLY,    CAP_MIN_MAIN_POLY,    s)

    // Execute trimming (Arrays are passed by reference and modified)
    trim_boxes(ghostBoxes, liveCapGhostBoxes, ops)
    trim_lines(ghostWicks, liveCapGhostWicks, ops)
    trim_polylines(mc_lines, liveCapMcLines, ops)
    trim_boxes(densBoxes, liveCapDensBoxes, ops)
    trim_polylines(fcstShapes, liveCapFcstShapes, ops)
    trim_labels(fcstLabels, liveCapFcstLabels, ops)
    trim_polylines(mainPoly, liveCapMainPoly, ops)

